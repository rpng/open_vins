FROM osrf/ros:noetic-desktop-full

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
      libboost-all-dev \
      libceres-dev \
      libeigen3-dev \
      python3-catkin-tools \
      python3-matplotlib \
      python3-numpy \
      python3-osrf-pycommon \
      python3-pip \
      python3-psutil \
      python3-tk \
    && python3 -m pip install --no-cache-dir \
         "evo==1.25.2" \
         "packaging==24.2" \
         "rosbags==0.9.19" \
         "seaborn==0.11.2" \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /catkin_ws/src/open_vins
COPY . .

WORKDIR /catkin_ws
RUN . /opt/ros/noetic/setup.sh \
    && catkin config \
         --extend /opt/ros/noetic \
         --cmake-args \
           -DCMAKE_BUILD_TYPE=Release \
           -DDISABLE_MATPLOTLIB=ON \
    && catkin build --no-status -j2

COPY benchmark/docker_entrypoint.sh /openvins_entrypoint.sh
ENTRYPOINT ["/openvins_entrypoint.sh"]
CMD ["bash"]
