# Fast remote rebuild after Stage-1-only source changes. Build the full
# Dockerfile.stage1 first; this image retains its catkin build cache.
FROM openvins-conformal:stage1

COPY conformal/stage1_dumps/run_asl_msckf.cpp \
     /catkin_ws/src/open_vins/conformal/stage1_dumps/run_asl_msckf.cpp

WORKDIR /catkin_ws
RUN . /opt/ros/noetic/setup.sh \
    && catkin build --no-status -j2 conformal_stage1
